__d((function(e,i,t,r,o,s,n){o.exports=[{id:"1",title:"Why is NEWME taking us to South Korea?",description:"We wanted to thank you guys for all the love you have shown us over the past year and take you on a fun trip that offers an immersive experience in Korean fashion, culture, and lifestyle, tailored specifically for our customers"},{id:"2",title:"Who is eligible to participate in this sponsored trip?",description:"This trip is exclusively for NEWME customers. On your updated App, make sure you complete your profile, and place an order to qualify!"},{id:"3",title:"How do I increase my chances of winning?",description:"Remember to refer as many friends as possible. Every order counts as one entry, so the more you shop, the luckier you get! :)"},{id:"4",title:"I have already placed an order but I have not registered. Will I be eligible?",description:"No, please ensure both the steps are completed. Any orders placed before or after registration will be counted as long as both steps have been fulfilled. (Applicable: April 1st onwards)"},{id:"5",title:"Is the trip fully sponsored?",description:"Yes! Just bring yourself, your favorite NEWME clothes and all your basic traveling essentials! The sponsorship covers accommodation, meals, transportation, guided tours, exclusive fashion experiences, and selected activities during the 6-day, 5-night trip"},{id:"6",title:"Are participants required to cover any additional costs during the trip?",description:"Participants are responsible for any personal expenses, shopping, souvenirs, or activities not included in the itinerary provided by NEWME."},{id:"7",title:"What happens if a selected participant is unable to join the trip after confirmation?",description:"If a selected participant is unable to join the trip after confirmation, they should inform NEWME as soon as possible so that an alternate participant can be selected to take their place."},{id:"8",title:"When will the first winner be announced?",description:"The first & second winners will be announced on April 15th & April 30th 2024 on our social media channels, App & via WhatsApp for participating customers! Total 12 NEWME OGs will be selected for the trip via lucky draw!"},{id:"9",title:"How does the itinerary look like?",description:"A detailed itinerary will be shared soon- but expect a unique and fun filled experience around Jeju island, Nami island, & Busan. "},{id:"10",title:"Are there any official documents required to participate in this trip?",description:"Selected winners must possess a functioning passport. VISA arrangements will be taken care of by NEWME."}]}),3638,[]);
